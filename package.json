{
  "name": "snowluma-agent",
  "version": "0.1.1",
  "description": "基于 pi 的安全 SnowLuma QQ AI Agent。",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pheobe-Southwood/SnowLuma-agent.git"
  },
  "homepage": "https://github.com/Pheobe-Southwood/SnowLuma-agent",
  "bugs": {
    "url": "https://github.com/Pheobe-Southwood/SnowLuma-agent/issues"
  },
  "type": "module",
  "bin": {
    "snowluma-agent": "dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "prepare": "npm run build",
    "prepack": "npm run check && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-ai": "0.83.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@snowluma/sdk": "1.14.0",
    "dotenv": "17.4.2",
    "typebox": "1.3.10"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.66.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
